# ==============================================================================
# Campus Resource Intelligence Assistant - Environment Configuration Template
# Copy this file to `.env` and adjust the variables to suit your local setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ollama & Gemma AI Configuration
# ------------------------------------------------------------------------------
# Base URL for the local Ollama daemon.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Gemma model to use for question intent interpretation and executive summaries.
# Download with: `ollama run gemma4:e2b` (or `gemma:2b`, `gemma2`)
OLLAMA_MODEL=gemma4:e2b

# Timeout in seconds for Ollama requests before falling back to the verified rule engine.
# Keeps the user experience responsive if the model is busy or running on CPU.
OLLAMA_TIMEOUT=4.0

# ------------------------------------------------------------------------------
# 2. Backend Server Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Host interface and port for Uvicorn
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Comma-separated list of allowed CORS origins for the React frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Dataset Configuration
# ------------------------------------------------------------------------------
# Optional path to an alternate default CSV dataset.
# Leave blank to use the built-in `backend/data/campus_electricity.csv`
DEFAULT_DATASET_PATH=

# ------------------------------------------------------------------------------
# 4. Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# Base API path for Vite dev server proxy
VITE_API_BASE_URL=/api

